//@version=5
indicator("4H HTF Support/Resistance Rays", overlay=true, max_lines_count=500, max_labels_count=500)

// ---------------------------
// Inputs
// ---------------------------
htf = input.timeframe("240", "Higher Timeframe")
showLabels = input.bool(true, "Show Labels")
resistanceColor = input.color(color.red, "Resistance Color")
supportColor = input.color(color.cyan, "Support Color")

// ---------------------------
// HTF Data
// ---------------------------
htfHigh = request.security(syminfo.tickerid, htf, high, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htfLow  = request.security(syminfo.tickerid, htf, low, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, htf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
htfOpen = request.security(syminfo.tickerid, htf, open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// ---------------------------
// Pivot Detection
// ---------------------------
r4 = ta.pivothigh(htfHigh, 2, 2)
s4 = ta.pivotlow(htfLow, 2, 2)

// ---------------------------
// Arrays
// ---------------------------
var line[] resLines = array.new_line()
var line[] supLines = array.new_line()
var float[] resVals = array.new_float()
var float[] supVals = array.new_float()

// ---------------------------
// Add Resistance
// ---------------------------
f_addResistance(float level, int x) =>
    exists = false
    for i = 0 to array.size(resVals) - 1
        if math.abs(level - array.get(resVals, i)) < syminfo.mintick * 50
            exists := true
            break
    if not exists
        ln = line.new(x, level, x + 500, level, extend=extend.right, color=resistanceColor, style=line.style_solid, width=2)
        array.push(resLines, ln)
        array.push(resVals, level)
        if showLabels
            label.new(x + 10, level, "HTF R: " + str.tostring(level, format.price), style=label.style_label_left, color=color.new(resistanceColor, 0), textcolor=color.white, size=size.tiny)

// ---------------------------
// Add Support
// ---------------------------
f_addSupport(float level, int x) =>
    exists = false
    for i = 0 to array.size(supVals) - 1
        if math.abs(level - array.get(supVals, i)) < syminfo.mintick * 50
            exists := true
            break
    if not exists
        ln = line.new(x, level, x + 500, level, extend=extend.right, color=supportColor, style=line.style_solid, width=2)
        array.push(supLines, ln)
        array.push(supVals, level)
        if showLabels
            label.new(x + 10, level, "HTF S: " + str.tostring(level, format.price), style=label.style_label_left, color=color.new(supportColor, 0), textcolor=color.black, size=size.tiny)

// ---------------------------
// Add Pivots
// ---------------------------
if barstate.isconfirmed
    if not na(r4)
        f_addResistance(r4, bar_index)
    if not na(s4)
        f_addSupport(s4, bar_index)

// ---------------------------
// Update Resistance Lines
// ---------------------------
for i = 0 to array.size(resLines) - 1
    lvl = array.get(resVals, i)
    ln = array.get(resLines, i)
    
    // Color change: Cyan when body closes ABOVE and continues up
    if htfClose > lvl and htfClose[1] <= lvl and htfClose > htfOpen
        line.set_color(ln, supportColor)
    // Back to Red if price returns below
    else if htfClose <= lvl
        line.set_color(ln, resistanceColor)
    
    line.set_x1(ln, bar_index - 500)
    line.set_x2(ln, bar_index + 500)

// ---------------------------
// Update Support Lines
// ---------------------------
for i = 0 to array.size(supLines) - 1
    lvl = array.get(supVals, i)
    ln = array.get(supLines, i)
    
    // Color change: Red when body closes BELOW and continues down
    if htfClose < lvl and htfClose[1] >= lvl and htfClose < htfOpen
        line.set_color(ln, resistanceColor)
    // Back to Cyan if price returns above
    else if htfClose >= lvl
        line.set_color(ln, supportColor)
    
    line.set_x1(ln, bar_index - 500)
    line.set_x2(ln, bar_index + 500)

// ---------------------------
// Debug Markers
// ---------------------------
plotchar(not na(r4), "Resistance Pivot", "▼", location.abovebar, resistanceColor, size=size.small)
plotchar(not na(s4), "Support Pivot", "▲", location.belowbar, supportColor, size=size.small)
